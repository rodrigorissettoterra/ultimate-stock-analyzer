# Never commit real secrets. Copy to .env locally.
USA_ENV=development
USA_LOG_LEVEL=INFO
USA_DATABASE_URL=postgresql+psycopg://usa:usa@localhost:5432/usa
USA_DATA_DIR=./data

# OpenAI-compatible LLM endpoint. Keep empty if news AI is disabled.
USA_LLM_API_KEY=
USA_LLM_BASE_URL=https://api.openai.com/v1
USA_LLM_MODEL=
USA_LLM_TIMEOUT_SECONDS=30

# Optional user agent for public-source collectors
USA_HTTP_USER_AGENT=ultimate-stock-analyzer/0.1 (+https://github.com/rodrigorissettoterra/ultimate-stock-analyzer)
