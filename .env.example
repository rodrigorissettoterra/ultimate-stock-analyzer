# Never commit real secrets. Copy this file to .env locally.
USA_ENV=development
USA_LOG_LEVEL=INFO
USA_DATABASE_URL=
USA_DATA_DIR=./data
USA_WORKER_HEARTBEAT_SECONDS=300

# Docker/PostgreSQL local deployment. Set a strong local password in .env.
POSTGRES_DB=usa
POSTGRES_USER=usa
POSTGRES_PASSWORD=

# OpenAI-compatible LLM endpoint. Keep key/model empty for deterministic agent mode.
USA_LLM_API_KEY=
USA_LLM_BASE_URL=https://api.openai.com/v1
USA_LLM_MODEL=
USA_LLM_TIMEOUT_SECONDS=30

# Optional user agent for public-source collectors.
USA_HTTP_USER_AGENT=ultimate-stock-analyzer/0.1 (+https://github.com/rodrigorissettoterra/ultimate-stock-analyzer)
